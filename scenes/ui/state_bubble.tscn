[sub_resource type="Shader" id="Shader_round"]
code = "shader_type canvas_item;

// Découpe le portrait en disque (bord adouci).
void fragment() {
	vec4 color = texture(TEXTURE, UV);
	color.a *= 1.0 - smoothstep(0.47, 0.5, distance(UV, vec2(0.5)));
	COLOR = color;
}
"

