[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mecha/tractor_beam.gd" id="1_beam"]
[ext_resource type="PackedScene" path="res://assets/models/props/beam_emitter.glb" id="2_emitter"]

[sub_resource type="Shader" id="Shader_beam"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_disabled, depth_draw_never, shadows_disabled;

// Colonne lumineuse : anneaux qui défilent dans le sens du rayon, bords plus lumineux, léger pouls.
uniform vec4 beam_color : source_color = vec4(0.35, 0.75, 1.0, 1.0);
uniform float direction = 1.0;
uniform float ring_count = 9.0;
uniform float scroll_speed = 0.5;

void fragment() {
	float rings = smoothstep(0.7, 1.0, fract(UV.y * ring_count + TIME * scroll_speed * direction));
	float edge = pow(1.0 - abs(dot(NORMAL, VIEW)), 2.0);
	float pulse = 0.85 + 0.15 * sin(TIME * 4.0);
	ALBEDO = beam_color.rgb;
	ALPHA = clamp((0.08 + 0.35 * rings + 0.3 * edge) * pulse, 0.0, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_beam"]
shader = SubResource("Shader_beam")

[sub_resource type="CylinderMesh" id="CylinderMesh_beam"]
material = SubResource("ShaderMaterial_beam")
top_radius = 0.4
bottom_radius = 0.4
height = 5.7
radial_segments = 20
rings = 1
cap_top = false
cap_bottom = false

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_beam"]
properties/0/path = NodePath(".:going_up")
properties/0/spawn = true
properties/0/replication_mode = 2

[node name="TractorBeam" type="Node3D"]
