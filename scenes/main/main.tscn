[node name="Main" type="Node"]

[node name="LobbyMenu" type="CanvasLayer" parent="."]
script = ExtResource("1_lobby")

[node name="Center" type="CenterContainer" parent="LobbyMenu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="LobbyMenu/Center"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="LobbyMenu/Center/Panel"]
