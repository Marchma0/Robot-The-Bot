[node name="Main" type="Node"]

[node name="LobbyMenu" type="CanvasLayer" parent="."]
script = ExtResource("1_lobby")

[node name="Center" type="CenterContainer" parent="LobbyMenu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="LobbyMenu/Center"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="LobbyMenu/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="LobbyMenu/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="LobbyMenu/Center/Panel/Margin/VBox"]
layout_mode = 2
text = "Mécha à Nains"
horizontal_alignment = 1

[node name="HostButton" type="Button" parent="LobbyMenu/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Héberger"

[node name="AddressEdit" type="LineEdit" parent="LobbyMenu/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "127.0.0.1"
placeholder_text = "Adresse de l'hôte"

[node name="JoinButton" type="Button" parent="LobbyMenu/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Rejoindre"

[node name="StatusLabel" type="Label" parent="LobbyMenu/Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3
[node name="World" type="Node3D" parent="."]

[node name="TestGround" parent="World" instance=ExtResource("4_ground")]

[node name="MenuCamera" type="Camera3D" parent="World"]
transform = Transform3D(0.707107, 0.0467, -0.705, 0, 0.997, 0.066, 0.707107, -0.0467, 0.705, -1, 6, 16)
current = true

[node name="Mecha" parent="World" instance=ExtResource("5_mecha")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 15, 0, 0)

[node name="CockpitTestMotion" type="Node" parent="World" node_paths=PackedStringArray("target")]
script = ExtResource("6_motion")
