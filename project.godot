[internationalization]

locale/translations=PackedStringArray("res://assets/translations/texts.en.translation", "res://assets/translations/texts.fr.translation")

[layer_names]

3d_render/layer_1="monde"
3d_render/layer_2="intérieur du robot"
3d_physics/layer_1="world"
3d_physics/layer_3="interactable"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/size=2048

[steam]

initialization/app_data/app_id=480
initialization/processes/initialize_on_startup=true
initialization/processes/embed_callbacks=true
