# Godot 4+ specific ignores
.godot/
/android/

# Exports
/build/*
!/build/.gdignore
/export/

# Blender : sauvegardes auto
*.blend1
*.blend2
*.blend@

# Claude Code : réglages locaux
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Addons tiers : non versionnés (trop lourds), liste et installation dans addons/ADDONS.txt
/addons/*
!/addons/ADDONS.txt
!/addons/.gitkeep

# Python (scripts Blender)
__pycache__/

# VS Code : réglages propres à chaque machine (chemin de Godot…)
.vscode/

# Blender : les .blend fabriqués par un script (le script fait foi, il les recrée) ne sont pas versionnés.
# Seuls mecha.blend et dwarf.blend, faits en partie à la main, le sont.
/blender/props/*.blend
/blender/levels/*.blend
/blender/mecha_legs.blend
