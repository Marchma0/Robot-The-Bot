{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "${GODOT_PATH}"
      }
    },
    "blender": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "uvx", "blender-mcp"]
    }
  }
}
